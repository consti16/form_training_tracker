<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>FORM — Training Tracker</title>
<style>
:root{--bg:#f5f6f8;--panel:#fff;--ink:#17211d;--muted:#7c8781;--line:#e8ece9;--green:#b8f36b;--green-dark:#315a22;--dark:#1b2922;--soft:#eff7e8;--orange:#ffb86b;--shadow:0 10px 35px rgba(23,33,29,.055)}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;letter-spacing:-.02em}button,input,select,textarea{font:inherit}button{cursor:pointer;border:0}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid #b8f36b;outline-offset:2px}
.app{display:grid;grid-template-columns:245px 1fr;min-height:100vh}.sidebar{background:var(--dark);color:#fff;padding:28px 18px;display:flex;flex-direction:column;gap:30px}.brand{display:flex;align-items:center;gap:11px;padding:0 12px}.brand-mark{width:35px;height:35px;background:var(--green);border-radius:11px;display:grid;place-items:center;color:var(--dark);font-weight:950;font-size:21px}.brand-name{font-size:18px;font-weight:850;letter-spacing:.08em}.brand-sub{font-size:10px;color:#9daaa2;letter-spacing:.18em;margin-top:2px}.nav-label{font-size:10px;color:#809088;letter-spacing:.18em;text-transform:uppercase;padding:0 14px;margin-bottom:8px}.nav{display:grid;gap:5px}.nav button{background:transparent;color:#b5c0b9;padding:13px 14px;border-radius:12px;text-align:left;display:flex;gap:12px;align-items:center;font-size:13px;font-weight:650;transition:.2s}.nav button .ico{width:20px;text-align:center;font-size:17px}.nav button.active,.nav button:hover{background:#2b3b31;color:#fff}.nav button.active:before{content:"";width:3px;height:19px;border-radius:4px;background:var(--green);margin-left:-14px;margin-right:11px}.side-bottom{margin-top:auto;background:#25352b;border:1px solid #34483a;border-radius:17px;padding:16px}.side-bottom .tiny{font-size:10px;color:#9cac9f;text-transform:uppercase;letter-spacing:.12em}.side-bottom strong{display:block;font-size:23px;margin:7px 0}.side-bottom p{font-size:11px;line-height:1.5;color:#b4c1b7;margin:0}
main{min-width:0;padding:30px clamp(18px,3.2vw,48px) 50px}.topbar{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:28px}.eyebrow{font-size:10px;color:var(--muted);letter-spacing:.16em;text-transform:uppercase;font-weight:750}.page-title{font-size:clamp(26px,3vw,36px);letter-spacing:-.055em;margin:5px 0 0;font-weight:800}.top-right{display:flex;align-items:center;gap:12px}.date-pill{border:1px solid var(--line);background:white;border-radius:12px;padding:11px 14px;font-size:12px;color:#57645c}.avatar{width:40px;height:40px;border-radius:14px;background:var(--green);display:grid;place-items:center;font-weight:850;color:#2a4321}
.page{display:none}.page.active{display:block}.welcome{background:var(--green);border-radius:23px;padding:27px 30px;display:flex;align-items:center;justify-content:space-between;gap:25px;overflow:hidden;position:relative;margin-bottom:22px}.welcome:after{content:"";position:absolute;width:220px;height:220px;border:35px solid rgba(49,90,34,.09);border-radius:50%;right:16%;top:-125px}.welcome h2{font-size:clamp(21px,2.4vw,29px);letter-spacing:-.05em;margin:7px 0 8px;max-width:520px}.welcome p{margin:0;color:#405b34;font-size:13px}.welcome .eyebrow{color:#456238}.welcome button{background:var(--dark);color:white;padding:13px 17px;border-radius:12px;font-size:12px;font-weight:750;white-space:nowrap;z-index:1}
.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:22px}.stat{background:var(--panel);border:1px solid var(--line);border-radius:17px;padding:19px;min-width:0}.stat-top{display:flex;justify-content:space-between;align-items:center;color:var(--muted);font-size:11px;font-weight:650}.stat-icon{width:30px;height:30px;background:#f1f5f1;border-radius:10px;display:grid;place-items:center}.stat strong{display:block;font-size:29px;letter-spacing:-.06em;margin:13px 0 4px}.stat small{font-size:10px;color:var(--muted)}.layout-2{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(280px,.85fr);gap:18px}.card{background:var(--panel);border:1px solid var(--line);border-radius:19px;padding:22px;min-width:0}.card-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:20px}.card-title{font-size:15px;font-weight:800;letter-spacing:-.03em}.card-sub{font-size:11px;color:var(--muted);margin-top:4px}.text-btn{background:transparent;color:#476c38;font-weight:750;font-size:11px;padding:7px}.primary{background:var(--dark);color:white;padding:12px 16px;border-radius:11px;font-size:12px;font-weight:750}.primary:hover{background:#2d4536}.secondary{background:#f0f3f0;color:#34443a;padding:11px 14px;border-radius:10px;font-size:12px;font-weight:700}.danger{color:#a74343;background:#fff0f0;padding:9px 12px;border-radius:9px;font-size:11px;font-weight:700}
.week-bars{display:flex;align-items:end;gap:12px;height:170px;padding:10px 3px 0}.bar-col{flex:1;display:flex;flex-direction:column;align-items:center;gap:8px;height:100%;justify-content:end}.bar-track{height:130px;width:min(100%,31px);display:flex;align-items:end;background:#f1f4f1;border-radius:8px;overflow:hidden}.bar-fill{width:100%;background:#b8f36b;border-radius:8px;min-height:0;transition:height .3s}.bar-col span{font-size:10px;color:var(--muted)}.bar-col em{font-size:9px;color:#87928a;font-style:normal}
.activity-list{display:grid;gap:10px}.activity{display:flex;align-items:center;gap:12px;padding:11px;background:#fafbfa;border-radius:12px}.activity-icon{width:39px;height:39px;border-radius:12px;background:#eaf4e3;display:grid;place-items:center;font-size:17px}.activity-info{flex:1;min-width:0}.activity-info strong{display:block;font-size:12px}.activity-info small{display:block;color:var(--muted);font-size:10px;margin-top:4px}.activity-count{font-size:11px;font-weight:750;color:#557347;white-space:nowrap}.empty{padding:24px 15px;text-align:center;color:var(--muted);font-size:12px;background:#fafbfa;border-radius:13px}
.calendar-wrap{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(270px,.8fr);gap:18px}.calendar-card{padding:22px}.month-nav{display:flex;align-items:center;gap:8px}.month-nav button{width:32px;height:32px;border-radius:9px;background:#f2f4f2;font-size:16px}.month-name{font-weight:800;font-size:15px;min-width:140px}.weekdays,.days{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:5px}.weekdays{margin-bottom:8px}.weekdays div{text-align:center;font-size:10px;color:var(--muted);padding:8px 0}.day{border-radius:11px;background:#fafbfa;min-height:72px;padding:8px 6px;text-align:left;border:1px solid transparent;position:relative;color:var(--ink);display:flex;flex-direction:column;align-items:center;gap:6px}.day:hover{border-color:#c8d6c2}.day.muted{opacity:.35}.day.selected{background:#eaf6df;border-color:#b8dc9d}.day.today .day-num{background:var(--dark);color:#fff}.day-num{font-size:11px;width:24px;height:24px;display:grid;place-items:center;border-radius:8px}.day-dot{width:5px;height:5px;border-radius:50%;background:#76ae50}.day-count{font-size:9px;color:#5c7e4d}.selected-date{font-size:11px;color:var(--muted);margin-top:3px}.workout-day-head{display:flex;align-items:start;justify-content:space-between;gap:10px}.workout-day-head h3{margin:0;font-size:17px;letter-spacing:-.04em}.workout-items{display:grid;gap:9px;margin-top:17px}.workout-item{border:1px solid var(--line);border-radius:13px;padding:13px}.workout-item-top{display:flex;justify-content:space-between;gap:10px;align-items:start}.workout-item strong{font-size:12px}.workout-item small{display:block;color:var(--muted);font-size:10px;margin-top:5px}.workout-actions{display:flex;gap:6px}.mini-btn{background:#f1f4f1;border-radius:8px;padding:7px 9px;font-size:10px}.mini-btn.del{color:#a74343}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px}.field{display:grid;gap:7px}.field.full{grid-column:1/-1}.field label{font-size:11px;font-weight:750;color:#5b685f}.field input,.field select,.field textarea{width:100%;border:1px solid #dfe5df;background:#fbfcfb;border-radius:10px;padding:12px;color:var(--ink);font-size:12px}.field textarea{resize:vertical;min-height:78px}.form-actions{display:flex;gap:8px;justify-content:flex-end;margin-top:16px}.exercise-chips{display:flex;flex-wrap:wrap;gap:7px}.chip{background:#f2f5f1;border:1px solid #e5eae4;border-radius:999px;padding:9px 12px;font-size:11px;color:#435147}.chip.selected{background:#e7f6dc;border-color:#b8dc9d;color:#315a22}.exercise-row{display:grid;grid-template-columns:minmax(130px,1.4fr) .7fr .7fr .7fr 32px;gap:8px;align-items:center;margin:8px 0}.exercise-row input,.exercise-row select{width:100%;min-width:0;padding:10px 8px;border:1px solid #e0e6e0;border-radius:9px;background:#fbfcfb;font-size:11px}.exercise-row .remove{background:#fff0f0;color:#b44c4c;border-radius:9px;height:34px}.table-labels{display:grid;grid-template-columns:minmax(130px,1.4fr) .7fr .7fr .7fr 32px;gap:8px;color:var(--muted);font-size:9px;padding:0 1px 4px;text-transform:uppercase;letter-spacing:.08em}.progress-list{display:grid;gap:14px}.progress-item{border:1px solid var(--line);border-radius:14px;padding:15px}.progress-top{display:flex;justify-content:space-between;gap:10px;align-items:center}.progress-top strong{font-size:12px}.progress-top span{font-size:10px;color:var(--muted)}.progress-track{height:7px;background:#edf1ed;border-radius:9px;overflow:hidden;margin:12px 0 8px}.progress-fill{height:100%;background:#a8e85d;border-radius:9px}.progress-foot{display:flex;justify-content:space-between;font-size:10px;color:var(--muted)}.history-table{width:100%;border-collapse:collapse;font-size:11px}.history-table th{text-align:left;color:var(--muted);font-size:9px;text-transform:uppercase;letter-spacing:.1em;padding:12px 9px;border-bottom:1px solid var(--line)}.history-table td{padding:14px 9px;border-bottom:1px solid #f0f2f0}.history-table tr:last-child td{border-bottom:0}.badge{background:#edf7e6;color:#4c713a;border-radius:99px;padding:6px 8px;font-size:9px;font-weight:750;white-space:nowrap}.notice{font-size:11px;color:var(--muted);line-height:1.6;background:#f8faf7;padding:13px;border-radius:11px;margin-top:15px}
.toast{position:fixed;right:24px;bottom:24px;background:#1b2922;color:white;padding:13px 18px;border-radius:12px;font-size:12px;box-shadow:var(--shadow);opacity:0;transform:translateY(10px);transition:.25s;pointer-events:none;z-index:10}.toast.show{opacity:1;transform:translateY(0)}
.modal-backdrop{position:fixed;inset:0;background:rgba(12,20,15,.48);display:none;align-items:center;justify-content:center;padding:18px;z-index:5}.modal-backdrop.open{display:flex}.modal{width:min(680px,100%);max-height:90vh;overflow:auto;background:white;border-radius:22px;padding:24px;box-shadow:0 25px 90px #0003}.modal-head{display:flex;align-items:start;justify-content:space-between;margin-bottom:20px}.modal-head h2{margin:4px 0;font-size:22px;letter-spacing:-.05em}.close{width:34px;height:34px;border-radius:10px;background:#f1f4f1;font-size:19px}.mobile-menu{display:none}
@media(max-width:1050px){.stats{grid-template-columns:repeat(2,minmax(0,1fr))}.layout-2,.calendar-wrap{grid-template-columns:1fr}.sidebar{width:210px}.app{grid-template-columns:210px 1fr}}
@media(max-width:700px){.app{display:block}.sidebar{padding:12px 14px;display:block;position:sticky;top:0;z-index:4}.brand{padding:0 4px}.brand-mark{width:31px;height:31px}.brand-name{font-size:15px}.brand-sub{display:none}.sidebar .nav-label,.side-bottom{display:none}.nav{display:flex;gap:5px;margin-top:12px;overflow-x:auto}.nav button{padding:9px 11px;white-space:nowrap;font-size:11px}.nav button .ico{font-size:14px;width:auto}.nav button.active:before{display:none}.nav button.active{background:#3b5142}main{padding:22px 14px 35px}.topbar{margin-bottom:20px}.top-right .date-pill{display:none}.welcome{padding:22px;align-items:flex-start;flex-direction:column}.welcome button{width:100%}.stats{gap:9px}.stat{padding:14px}.stat strong{font-size:25px}.card{padding:16px}.day{min-height:57px;padding:5px 2px}.day-num{width:22px;height:22px}.day-count{font-size:8px}.calendar-card{padding:13px}.calendar-wrap{gap:12px}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.exercise-row{grid-template-columns:minmax(90px,1.3fr) .65fr .65fr .65fr 28px;gap:4px}.exercise-row input{padding:9px 4px;font-size:10px}.table-labels{grid-template-columns:minmax(90px,1.3fr) .65fr .65fr .65fr 28px;gap:4px;font-size:8px}.history-table th,.history-table td{padding:10px 5px}.topbar .page-title{font-size:27px}}
</style>
</head>
<body>
<div class="app">
<aside class="sidebar">
  <div class="brand"><div class="brand-mark">F</div><div><div class="brand-name">FORM</div><div class="brand-sub">TRAINING TRACKER</div></div></div>
  <div><div class="nav-label">Workspace</div><nav class="nav">
    <button class="active" data-page="dashboard"><span class="ico">◫</span>Übersicht</button>
    <button data-page="calendar"><span class="ico">▦</span>Kalender</button>
    <button data-page="progress"><span class="ico">↗</span>Fortschritt</button>
    <button data-page="history"><span class="ico">◷</span>Trainingshistorie</button>
  </nav></div>
  <div class="side-bottom"><div class="tiny">Deine Konstanz</div><strong id="sideStreak">0 Tage</strong><p>Jedes Training zählt. Bleib dran und baue Schritt für Schritt auf.</p></div>
</aside>
<main>
  <header class="topbar"><div><div class="eyebrow" id="todayLabel">DEIN TRAINING. DEIN RHYTHMUS.</div><h1 class="page-title" id="pageTitle">Dein Dashboard</h1></div><div class="top-right"><div class="date-pill" id="topDate"></div><div class="avatar">F</div></div></header>
  <section class="page active" id="page-dashboard">
    <div class="welcome"><div><div class="eyebrow">DEIN WEG. DEIN TEMPO.</div><h2>Stärker werden beginnt mit dem nächsten Satz.</h2><p>Tracke deine Einheiten, erkenne Fortschritte und bleib konsequent.</p></div><button onclick="openWorkout()">＋ Training eintragen</button></div>
    <div class="stats">
      <div class="stat"><div class="stat-top">Workouts gesamt <span class="stat-icon">▣</span></div><strong id="statTotal">0</strong><small>Alle gespeicherten Einheiten</small></div>
      <div class="stat"><div class="stat-top">Diese Woche <span class="stat-icon">◷</span></div><strong id="statWeek">0</strong><small>Trainings seit Montag</small></div>
      <div class="stat"><div class="stat-top">Trainingsvolumen <span class="stat-icon">↗</span></div><strong id="statVolume">0</strong><small>Wiederholungen insgesamt</small></div>
      <div class="stat"><div class="stat-top">Aktive Übungen <span class="stat-icon">✳</span></div><strong id="statExercises">0</strong><small>In deinen Workouts verwendet</small></div>
    </div>
    <div class="layout-2">
      <div class="card"><div class="card-head"><div><div class="card-title">Deine Trainingswoche</div><div class="card-sub">Workouts pro Wochentag</div></div><span class="badge">AKTUELLE WOCHE</span></div><div class="week-bars" id="weekBars"></div></div>
      <div class="card"><div class="card-head"><div><div class="card-title">Zuletzt trainiert</div><div class="card-sub">Deine letzten Einheiten im Überblick</div></div><button class="text-btn" onclick="navigate('history')">Alle ansehen ↗</button></div><div class="activity-list" id="recentList"></div></div>
    </div>
  </section>
  <section class="page" id="page-calendar">
    <div class="calendar-wrap">
      <div class="card calendar-card"><div class="card-head"><div><div class="card-title">Trainingskalender</div><div class="card-sub">Wähle einen Tag aus oder trage ein Workout ein.</div></div><button class="primary" onclick="openWorkout()">＋ Workout</button></div>
      <div class="card-head" style="margin-bottom:12px"><div class="month-nav"><button onclick="changeMonth(-1)" aria-label="Vorheriger Monat">‹</button><div class="month-name" id="monthName"></div><button onclick="changeMonth(1)" aria-label="Nächster Monat">›</button></div><button class="text-btn" onclick="goToday()">Heute</button></div>
      <div class="weekdays"><div>MO</div><div>DI</div><div>MI</div><div>DO</div><div>FR</div><div>SA</div><div>SO</div></div><div class="days" id="calendarDays"></div>
      </div>
      <div class="card"><div class="workout-day-head"><div><h3 id="selectedDateTitle">Ausgewählter Tag</h3><div class="selected-date" id="selectedDateSub"></div></div><button class="secondary" onclick="openWorkout()">＋ Hinzufügen</button></div><div class="workout-items" id="dayWorkouts"></div></div>
    </div>
  </section>
  <section class="page" id="page-progress">
    <div class="card" style="margin-bottom:18px"><div class="card-head"><div><div class="card-title">Übungsfortschritt</div><div class="card-sub">Vergleiche deine Wiederholungen und Sätze über die Zeit.</div></div><select id="progressFilter" onchange="renderProgress()" style="max-width:220px;border:1px solid var(--line);padding:10px;border-radius:10px;background:#fafbfa;font-size:11px"><option value="all">Alle Übungen</option></select></div><div class="progress-list" id="progressList"></div></div>
    <div class="layout-2"><div class="card"><div class="card-head"><div><div class="card-title">Persönliche Bestwerte</div><div class="card-sub">Höchste dokumentierte Wiederholungszahl in einem Satz</div></div></div><div id="personalBests" class="activity-list"></div></div><div class="card"><div class="card-head"><div><div class="card-title">So liest du deinen Fortschritt</div></div></div><p style="font-size:12px;color:var(--muted);line-height:1.8;margin:0">Der Fortschritt basiert auf deinen gespeicherten Workout-Einträgen. Halte Übungen und Einheiten möglichst konsistent fest. Mehr Wiederholungen, zusätzliche Sätze oder mehr Gewicht können Hinweise auf deine Entwicklung sein.</p><div class="notice">Tipp: Trage auch leichte Einheiten ein. So entsteht ein realistisches Bild deiner Trainingskonstanz.</div></div></div>
  </section>
  <section class="page" id="page-history">
    <div class="card"><div class="card-head"><div><div class="card-title">Trainingshistorie</div><div class="card-sub">Alle Einheiten, chronologisch sortiert.</div></div><button class="primary" onclick="openWorkout()">＋ Workout eintragen</button></div><div style="overflow-x:auto"><table class="history-table"><thead><tr><th>Datum</th><th>Workout</th><th>Übungen</th><th>Wdh.</th><th></th></tr></thead><tbody id="historyBody"></tbody></table></div><div class="notice">Deine Daten werden lokal in diesem Browser gespeichert. Nutze „Daten exportieren“ in den Einstellungen des Browsers? Nein — über den Export-Button unten kannst du eine Sicherung als JSON speichern.</div><div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:14px"><button class="secondary" onclick="exportData()">↓ Daten exportieren</button><button class="secondary" onclick="document.getElementById('importFile').click()">↑ Daten importieren</button><input type="file" id="importFile" accept=".json,application/json" hidden onchange="importData(event)"></div></div>
  </section>
</main>
</div>
<div class="modal-backdrop" id="workoutModal" onclick="if(event.target===this)closeWorkout()"><div class="modal"><div class="modal-head"><div><div class="eyebrow">TRAININGSPROTOKOLL</div><h2 id="modalTitle">Workout eintragen</h2></div><button class="close" onclick="closeWorkout()">×</button></div>
<form id="workoutForm" onsubmit="saveWorkout(event)">
<div class="form-grid"><div class="field"><label for="workoutName">Name des Workouts</label><input id="workoutName" placeholder="z. B. Oberkörper A" required></div><div class="field"><label for="workoutDate">Datum</label><input id="workoutDate" type="date" required></div><div class="field full"><label for="workoutNotes">Notiz (optional)</label><textarea id="workoutNotes" placeholder="Wie lief das Training? Energie, Technik, Besonderheiten …"></textarea></div></div>
<div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin:22px 0 12px"><div><div class="card-title">Übungen & Leistung</div><div class="card-sub">Sätze, Wiederholungen und optionales Zusatzgewicht erfassen.</div></div><button type="button" class="secondary" onclick="addExerciseRow()">＋ Übung</button></div>
<div class="table-labels"><span>Übung</span><span>Sätze</span><span>Wdh./Satz</span><span>Gewicht kg</span><span></span></div><div id="exerciseRows"></div>
<div class="field full" style="margin-top:12px"><label>Übung schnell hinzufügen</label><div class="exercise-chips" id="exerciseChips"></div></div>
<div class="form-actions"><button type="button" class="secondary" onclick="closeWorkout()">Abbrechen</button><button type="submit" class="primary">Workout speichern ↗</button></div>
</form></div></div>
<div class="toast" id="toast"></div>
<script>
const PRESETS=['Liegestütze','Klimmzüge','Dips','Hanging Leg-Raises','Kniebeugen','Sit-ups','Ausfallschritte','Plank','Burpees','Mountain Climbers','Laufen','Rudern','Schulterdrücken','Bankdrücken','Kreuzheben','Bizepscurls','Trizepsdrücken','Wadenheben'];
const ICONS={'Liegestütze':'↗','Klimmzüge':'↑','Dips':'⌁','Hanging Leg-Raises':'⌃','Kniebeugen':'↘','Sit-ups':'◉','Ausfallschritte':'⇢','Plank':'▬','Burpees':'✳','Mountain Climbers':'⌁','Laufen':'⌁','Rudern':'↔','Schulterdrücken':'↑','Bankdrücken':'↗','Kreuzheben':'↟','Bizepscurls':'∩','Trizepsdrücken':'↓','Wadenheben':'↑'};
const $=id=>document.getElementById(id);
const today=new Date(); const iso=d=>`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
let selectedDate=iso(today), viewYear=today.getFullYear(), viewMonth=today.getMonth(), editingId=null;
let workouts=[];try{workouts=JSON.parse(localStorage.getItem('form-workouts-v1')||'[]')}catch(e){workouts=[]}
const fmtDate=s=>new Date(s+'T12:00:00').toLocaleDateString('de-DE',{day:'2-digit',month:'long',year:'numeric'});
const fmtShort=s=>new Date(s+'T12:00:00').toLocaleDateString('de-DE',{day:'2-digit',month:'short'});
const save=()=>localStorage.setItem('form-workouts-v1',JSON.stringify(workouts));
const totalReps=w=>(w.exercises||[]).reduce((n,e)=>n+(+e.sets||0)*(+e.reps||0),0);
const allExercises=()=>[...new Set(workouts.flatMap(w=>(w.exercises||[]).map(e=>e.name)))].sort();
function toast(msg){$('toast').textContent=msg;$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),2400)}
function navigate(page){document.querySelectorAll('.page').forEach(p=>p.classList.toggle('active',p.id==='page-'+page));document.querySelectorAll('.nav button').forEach(b=>b.classList.toggle('active',b.dataset.page===page));const titles={dashboard:'Dein Dashboard',calendar:'Trainingskalender',progress:'Dein Fortschritt',history:'Trainingshistorie'};$('pageTitle').textContent=titles[page];if(page==='calendar')renderCalendar();if(page==='progress')renderProgress();if(page==='history')renderHistory();window.scrollTo({top:0,behavior:'smooth'})}
document.querySelectorAll('.nav button').forEach(b=>b.addEventListener('click',()=>navigate(b.dataset.page)));
$('topDate').textContent=today.toLocaleDateString('de-DE',{weekday:'short',day:'2-digit',month:'short',year:'numeric'});
$('todayLabel').textContent=today.toLocaleDateString('de-DE',{weekday:'long',day:'numeric',month:'long'}).toUpperCase();
function renderDashboard(){let weekStart=new Date(today);weekStart.setHours(0,0,0,0);weekStart.setDate(today.getDate()-((today.getDay()+6)%7));let weekEnd=new Date(weekStart);weekEnd.setDate(weekStart.getDate()+7);let thisWeek=workouts.filter(w=>{let d=new Date(w.date+'T12:00:00');return d>=weekStart&&d<weekEnd});$('statTotal').textContent=workouts.length;$('statWeek').textContent=thisWeek.length;$('statVolume').textContent=workouts.reduce((n,w)=>n+totalReps(w),0).toLocaleString('de-DE');$('statExercises').textContent=allExercises().length;
let days=['Mo','Di','Mi','Do','Fr','Sa','So'];$('weekBars').innerHTML=days.map((d,i)=>{let dt=new Date(weekStart);dt.setDate(dt.getDate()+i);let count=workouts.filter(w=>w.date===iso(dt)).length;return `<div class="bar-col"><em>${count||''}</em><div class="bar-track"><div class="bar-fill" style="height:${Math.min(100,count*50)}%"></div></div><span>${d}</span></div>`}).join('');
let recent=[...workouts].sort((a,b)=>b.date.localeCompare(a.date)).slice(0,4);$('recentList').innerHTML=recent.length?recent.map(w=>`<div class="activity"><div class="activity-icon">✳</div><div class="activity-info"><strong>${esc(w.name)}</strong><small>${fmtShort(w.date)} · ${(w.exercises||[]).length} Übungen</small></div><div class="activity-count">${totalReps(w)} Wdh.</div></div>`).join(''):'<div class="empty">Noch keine Workouts gespeichert.<br>Trage deine erste Einheit ein.</div>';
$('sideStreak').textContent=calcStreak()+' '+(calcStreak()===1?'Tag':'Tage')}
function calcStreak(){let dates=[...new Set(workouts.map(w=>w.date))].sort().reverse();if(!dates.length)return 0;let d=new Date(today);if(!dates.includes(iso(d)))d.setDate(d.getDate()-1);let n=0;while(dates.includes(iso(d))){n++;d.setDate(d.getDate()-1)}return n}
function renderCalendar(){const first=new Date(viewYear,viewMonth,1),last=new Date(viewYear,viewMonth+1,0);$('monthName').textContent=first.toLocaleDateString('de-DE',{month:'long',year:'numeric'});let offset=(first.getDay()+6)%7;let cells=Math.ceil((offset+last.getDate())/7)*7;let html='';for(let i=0;i<cells;i++){let num=i-offset+1;let d=new Date(viewYear,viewMonth,num);let key=iso(d),valid=d.getMonth()===viewMonth,items=workouts.filter(w=>w.date===key);html+=`<button class="day ${valid?'':'muted'} ${key===selectedDate?'selected':''} ${key===iso(today)?'today':''}" onclick="selectDay('${key}')"><span class="day-num">${d.getDate()}</span>${items.length?`<span class="day-dot"></span><span class="day-count">${items.length} ${items.length===1?'Workout':'Workouts'}</span>`:''}</button>`}$('calendarDays').innerHTML=html;renderDayWorkouts()}
function changeMonth(n){viewMonth+=n;if(viewMonth<0){viewMonth=11;viewYear--}if(viewMonth>11){viewMonth=0;viewYear++}renderCalendar()}
function goToday(){viewYear=today.getFullYear();viewMonth=today.getMonth();selectDay(iso(today))}
function selectDay(key){selectedDate=key;let d=new Date(key+'T12:00:00');viewYear=d.getFullYear();viewMonth=d.getMonth();renderCalendar()}
function renderDayWorkouts(){$('selectedDateTitle').textContent=new Date(selectedDate+'T12:00:00').toLocaleDateString('de-DE',{weekday:'long',day:'numeric',month:'long'});$('selectedDateSub').textContent=fmtDate(selectedDate);let items=workouts.filter(w=>w.date===selectedDate);$('dayWorkouts').innerHTML=items.length?items.map(w=>`<div class="workout-item"><div class="workout-item-top"><div><strong>${esc(w.name)}</strong><small>${(w.exercises||[]).length} Übungen · ${totalReps(w)} Wiederholungen</small></div><div class="workout-actions"><button class="mini-btn" onclick="editWorkout('${w.id}')">Bearbeiten</button><button class="mini-btn del" onclick="deleteWorkout('${w.id}')">×</button></div></div>${w.notes?`<small style="line-height:1.5">${esc(w.notes)}</small>`:''}</div>`).join(''):'<div class="empty">An diesem Tag ist noch nichts geplant.<br>Wie wäre es mit einer Einheit?</div>'}
function openWorkout(date=selectedDate){editingId=null;$('workoutForm').reset();$('modalTitle').textContent='Workout eintragen';$('workoutDate').value=date;$('workoutName').value='';$('workoutNotes').value='';$('exerciseRows').innerHTML='';addExerciseRow('Liegestütze');addExerciseRow('Klimmzüge');renderChips();$('workoutModal').classList.add('open')}
function closeWorkout(){$('workoutModal').classList.remove('open')}
function renderChips(){let used=[...document.querySelectorAll('.exercise-name')].map(x=>x.value);$('exerciseChips').innerHTML=PRESETS.map(n=>`<button type="button" class="chip ${used.includes(n)?'selected':''}" onclick="addExerciseRow('${n.replace(/'/g,"\\'")}')">${n}</button>`).join('')}
function addExerciseRow(name='Liegestütze',sets=3,reps=10,weight=''){let row=document.createElement('div');row.className='exercise-row';row.innerHTML=`<select class="exercise-name" aria-label="Übung">${PRESETS.map(n=>`<option ${n===name?'selected':''}>${n}</option>`).join('')}<option ${!PRESETS.includes(name)?'selected':''}>${!PRESETS.includes(name)?esc(name):''}</option></select><input class="exercise-sets" type="number" min="1" max="99" value="${sets}" aria-label="Sätze"><input class="exercise-reps" type="number" min="0" max="999" value="${reps}" aria-label="Wiederholungen pro Satz"><input class="exercise-weight" type="number" min="0" step=".5" placeholder="—" value="${weight}" aria-label="Gewicht in kg"><button type="button" class="remove" onclick="this.parentElement.remove();renderChips()">×</button>`;$('exerciseRows').appendChild(row);row.querySelector('select').addEventListener('change',renderChips);renderChips()}
function saveWorkout(e){e.preventDefault();let exercises=[...document.querySelectorAll('.exercise-row')].map(r=>({name:r.querySelector('.exercise-name').value,sets:+r.querySelector('.exercise-sets').value||0,reps:+r.querySelector('.exercise-reps').value||0,weight:r.querySelector('.exercise-weight').value===''?null:+r.querySelector('.exercise-weight').value})).filter(x=>x.name&&x.sets>0);if(!exercises.length){toast('Bitte füge mindestens eine Übung hinzu.');return}let w={id:editingId||String(Date.now()),name:$('workoutName').value.trim(),date:$('workoutDate').value,notes:$('workoutNotes').value.trim(),exercises};if(editingId)workouts=workouts.map(x=>x.id===editingId?w:x);else workouts.push(w);selectedDate=w.date;let d=new Date(w.date+'T12:00:00');viewYear=d.getFullYear();viewMonth=d.getMonth();save();closeWorkout();refresh();navigate('calendar');toast(editingId?'Workout aktualisiert.':'Workout gespeichert.');editingId=null}
function editWorkout(id){let w=workouts.find(x=>x.id===id);if(!w)return;editingId=id;$('modalTitle').textContent='Workout bearbeiten';$('workoutName').value=w.name;$('workoutDate').value=w.date;$('workoutNotes').value=w.notes||'';$('exerciseRows').innerHTML='';(w.exercises||[]).forEach(e=>addExerciseRow(e.name,e.sets,e.reps,e.weight??''));renderChips();$('workoutModal').classList.add('open')}
function deleteWorkout(id){if(!confirm('Dieses Workout wirklich löschen?'))return;workouts=workouts.filter(w=>w.id!==id);save();refresh();toast('Workout gelöscht.')}
function renderProgress(){let names=allExercises(),filter=$('progressFilter').value;$('progressFilter').innerHTML='<option value="all">Alle Übungen</option>'+names.map(n=>`<option value="${esc(n)}" ${filter===n?'selected':''}>${esc(n)}</option>`).join('');let selected=$('progressFilter').value;let items=names.filter(n=>selected==='all'||n===selected).map(name=>{let history=workouts.slice().sort((a,b)=>a.date.localeCompare(b.date)).flatMap(w=>(w.exercises||[]).filter(e=>e.name===name).map(e=>({...e,date:w.date,workout:w.name})));return {name,history}}).filter(x=>x.history.length).sort((a,b)=>b.history.length-a.history.length);$('progressList').innerHTML=items.length?items.map(x=>{let first=x.history[0],last=x.history[x.history.length-1],max=Math.max(...x.history.map(e=>e.reps)),delta=last.reps-first.reps,vol=x.history.reduce((n,e)=>n+e.sets*e.reps,0);return `<div class="progress-item"><div class="progress-top"><strong>${esc(x.name)}</strong><span>${x.history.length} Einträge</span></div><div class="progress-track"><div class="progress-fill" style="width:${Math.max(5,Math.min(100,(last.reps/Math.max(1,max))*100))}%"></div></div><div class="progress-foot"><span>Zuletzt: ${last.sets} × ${last.reps}${last.weight?` · ${last.weight} kg`:''}</span><span>Bestwert: ${max} Wdh./Satz</span></div><div class="progress-foot" style="margin-top:8px"><span>Gesamtvolumen: ${vol} Wdh.</span><span>${delta>0?'+':''}${delta} Wdh. seit Start</span></div></div>`}).join(''):'<div class="empty">Noch keine Übungsdaten vorhanden. Speichere Workouts, um deinen Fortschritt zu sehen.</div>';
let bests=items.map(x=>({name:x.name,best:Math.max(...x.history.map(e=>e.reps)),count:x.history.length})).sort((a,b)=>b.best-a.best).slice(0,5);$('personalBests').innerHTML=bests.length?bests.map(x=>`<div class="activity"><div class="activity-icon">${ICONS[x.name]||'↗'}</div><div class="activity-info"><strong>${esc(x.name)}</strong><small>${x.count} dokumentierte Einträge</small></div><div class="activity-count">${x.best} Wdh.</div></div>`).join(''):'<div class="empty">Deine Bestwerte erscheinen hier, sobald du trainiert hast.</div>'}
function renderHistory(){let sorted=[...workouts].sort((a,b)=>b.date.localeCompare(a.date));$('historyBody').innerHTML=sorted.length?sorted.map(w=>`<tr><td>${fmtShort(w.date)}</td><td><strong>${esc(w.name)}</strong>${w.notes?`<div style="color:#87928a;margin-top:4px">${esc(w.notes)}</div>`:''}</td><td>${(w.exercises||[]).length}</td><td>${totalReps(w)}</td><td><button class="mini-btn" onclick="editWorkout('${w.id}')">Öffnen</button></td></tr>`).join(''):'<tr><td colspan="5"><div class="empty">Noch keine Trainings gespeichert.</div></td></tr>'}
function refresh(){renderDashboard();renderCalendar();renderProgress();renderHistory()}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function exportData(){let blob=new Blob([JSON.stringify(workouts,null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='form-training-backup.json';a.click();URL.revokeObjectURL(url);toast('Export wurde erstellt.')}
function importData(e){let file=e.target.files[0];if(!file)return;let reader=new FileReader();reader.onload=()=>{try{let data=JSON.parse(reader.result);if(!Array.isArray(data))throw Error();workouts=data;save();refresh();toast('Daten erfolgreich importiert.')}catch(err){alert('Die Datei konnte nicht gelesen werden. Bitte wähle einen gültigen FORM-JSON-Export.')}e.target.value=''};reader.readAsText(file)}
refresh();
</script>
</body>
</html>
